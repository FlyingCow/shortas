# Shortas Dashboard Environment Configuration
# Copy this file to .env.local and configure for your environment

# Keycloak Configuration
REACT_APP_KEYCLOAK_URL=http://localhost:8080
REACT_APP_KEYCLOAK_CLIENT_ID=shortas-dashboard

# API Configuration
REACT_APP_PROXY_API_URL=http://localhost:8090

# Route favicons (minio-nginx). In Docker: set in docker-compose environment (see ui/.env.example).
REACT_APP_ROUTE_IMAGES_BASE_URL=http://localhost:9003

# Development Options
# Set to true to use mock data and bypass Keycloak authentication
REACT_APP_USE_MOCK_DATA=true

# Environment
NODE_ENV=development

# Optional: Logging level
REACT_APP_LOG_LEVEL=debug

# Optional: Feature flags
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_ROUTE_MANAGEMENT=true

# Production settings (when deploying)
# NODE_ENV=production
# REACT_APP_USE_MOCK_DATA=false
# REACT_APP_KEYCLOAK_URL=https://auth.yourdomain.com
# REACT_APP_API_BASE_URL=https://api.yourdomain.com
