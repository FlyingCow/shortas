# Generated by Cargo
# will have compiled files and executables
debug/
target/
infra/custom/fs/**

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Local config files (environment-specific overrides)
**/config/local.toml

# Environment files
.env
.env.*
!.env.example
!.env.*.example
