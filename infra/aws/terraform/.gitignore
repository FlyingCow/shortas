# Local .terraform directories (downloaded providers/modules - regenerated by `terraform init`)
**/.terraform/*

# Terraform lock files are intentionally NOT ignored (commit them for reproducible
# provider versions) except at environment roots, where `terraform init` runs directly
# and regenerates them locally during development:
environments/*/.terraform.lock.hcl

# State files - these contain plaintext secrets (DB passwords, etc.) and must
# never be committed. Use the S3 backend (see each environment's backend.tf).
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Variable files that may contain secrets
*.tfvars.local
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc
