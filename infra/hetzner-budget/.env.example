# Budget single-VM deployment — copy to .env and fill in.
# Generate strong random values (`openssl rand -hex 24`) for every
# changeme-* — this box is internet-facing.

# Images built by .github/workflows/docker-publish.yml. Pin a commit SHA or
# release tag in real use, not "latest".
IMAGE_REGISTRY=ghcr.io/flyingcow/shortas
IMAGE_TAG=latest

# Two IPv4 addresses on this one server — see README.md "Two IPs on one
# server" for why: Caddy (app hostnames) and click-router (short-link
# domains) both need standard ports 443/80, which only works if they bind
# to different IPs. PRIMARY_IP is the server's original/main IP;
# SHORTLINK_IP is a second IPv4 you attach to the same server via the
# Hetzner Console, then point your short-link domain(s) at.
PRIMARY_IP=203.0.113.10
SHORTLINK_IP=203.0.113.11

# --- Databases (one Postgres instance serves both) ---
API_DB_NAME=shortas_db
API_DB_USER=shortas_user
API_DB_PASSWORD=changeme-api-db

KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=changeme-keycloak-db

MONGO_ROOT_USER=shortas
MONGO_ROOT_PASSWORD=changeme-mongo

CLICKHOUSE_PASSWORD=changeme-clickhouse
REDIS_PASSWORD=changeme-redis

RABBITMQ_USER=shortas
RABBITMQ_PASSWORD=changeme-rabbitmq

# Self-hosted MinIO/RustFS credentials (not Hetzner Object Storage — see
# README.md for why).
S3_ACCESS_KEY=changeme-s3-access-key
S3_SECRET_KEY=changeme-s3-secret-key
S3_ROUTE_IMAGES_BUCKET=route-images

# Google Safe Browsing API key for route-verifier. Get one at
# https://console.cloud.google.com. NOTE: redirect/route-verifier/.env in
# this repo has a key committed in plaintext — rotate it, don't reuse it.
GSB_API_KEY=changeme-gsb-api-key

# --- Auth ---
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=changeme-keycloak-admin
# Must match the "realm" field in infra/custom/keycloak/realm-export.json
# ("shortas-dev") — not just a label, this becomes part of the JWKS/issuer
# URL management-api and the dashboard actually call.
KEYCLOAK_REALM=shortas-dev
KEYCLOAK_HOSTNAME=auth.yourdomain.com

# --- Public hostnames (point DNS A records at this box's IP) ---
DASHBOARD_HOSTNAME=dashboard.yourdomain.com
LANDING_HOSTNAME=yourdomain.com
API_HOSTNAME=api.yourdomain.com
S3_PUBLIC_HOSTNAME=images.yourdomain.com
# Only used if you enable the observability profile (see README.md).
GRAFANA_HOSTNAME=grafana.yourdomain.com
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme-grafana-admin

# --- Custom short-link domains ---
# Comma-separated public IPs that short-link domains may point their A
# records at. On this tier that's the box's SECOND (floating) IP — the one
# click-router listens on (see README "DNS"). Add more if you add IPs/nodes.
# Verification passes when at least one of a domain's A records is in this
# list; the dashboard lists them all as the records users should set.
DOMAIN_ALLOWED_IPV4=203.0.113.20
# Optional, same format. Leave empty to skip AAAA checks.
DOMAIN_ALLOWED_IPV6=

# --- Email (Mailhog is dropped from this tier — use a real provider) ---
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USERNAME=changeme
SMTP_PASSWORD=changeme
EMAIL_FROM_ADDRESS=no-reply@yourdomain.com

# --- cert-bot ---
ACME_ACCOUNT_EMAIL=you@yourdomain.com
