# App node — copy to .env next to docker-compose.app.yml and fill in.
# Deploy the SAME file to both app nodes (app-node-1 and app-node-2).

# Where images come from (see ../../.github/workflows/docker-publish.yml).
# Use a specific commit SHA or release tag in production, not "latest".
IMAGE_REGISTRY=ghcr.io/flyingcow/shortas
IMAGE_TAG=latest

# Private IPs (Hetzner Cloud Network) of the other nodes.
DATA_NODE_IP=10.0.0.2
PLATFORM_NODE_IP=10.0.0.10

# Must match .env.data on the data node.
MONGO_ROOT_USER=shortas
MONGO_ROOT_PASSWORD=changeme-mongo
API_DB_NAME=shortas_db
API_DB_USER=shortas_user
API_DB_PASSWORD=changeme-api-db
CLICKHOUSE_PASSWORD=changeme-clickhouse
REDIS_PASSWORD=changeme-redis
RABBITMQ_USER=shortas
RABBITMQ_PASSWORD=changeme-rabbitmq

# Must match .env.platform on the platform node.
KEYCLOAK_HOSTNAME=auth.yourdomain.com
# Must match the "realm" field in infra/custom/keycloak/realm-export.json
# ("shortas-dev") — not just a label, this becomes part of the JWKS/issuer
# URL management-api and the dashboard actually call.
KEYCLOAK_REALM=shortas-dev

# Public hostnames this node's Caddy will fetch Let's Encrypt certs for.
# Point DNS A/AAAA records for all three at BOTH app nodes' public IPs (or,
# better, at the app-tier Load Balancer's IP) once it's set up.
DASHBOARD_HOSTNAME=dashboard.yourdomain.com
LANDING_HOSTNAME=yourdomain.com
API_HOSTNAME=api.yourdomain.com

# Hetzner Object Storage (S3-compatible), replacing self-hosted MinIO.
# Create the bucket + an API credential pair in the Hetzner Console first.
S3_ENDPOINT=https://nbg1.your-objectstorage.com
S3_PUBLIC_ENDPOINT=https://nbg1.your-objectstorage.com
S3_REGION=nbg1
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme
S3_ROUTE_IMAGES_BUCKET=shortas-route-images

# Real email delivery — Mailhog is dev-only. SES/Postmark/Mailgun SMTP creds.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USERNAME=changeme
SMTP_PASSWORD=changeme
EMAIL_FROM_ADDRESS=no-reply@yourdomain.com

# cert-bot (singleton only — see docker-compose.app.yml)
ACME_ACCOUNT_EMAIL=you@yourdomain.com
