# Platform node — copy to .env next to docker-compose.platform.yml and fill in.

# Private IPs (Hetzner Cloud Network) of the other nodes.
DATA_NODE_IP=10.0.0.2
APP_NODE_1_IP=10.0.0.11
APP_NODE_2_IP=10.0.0.12

# Must match .env.data on the data node.
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=changeme-keycloak-db

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=changeme-keycloak-admin
# Public hostname Keycloak issues tokens under — must match what the
# dashboard/management-api expect as JWT issuer (see .env.app's
# KEYCLOAK_HOSTNAME / KEYCLOAK_REALM).
KEYCLOAK_HOSTNAME=auth.yourdomain.com
# Must match the "realm" field in infra/custom/keycloak/realm-export.json
# ("shortas-dev") and .env.app's KEYCLOAK_REALM — used by
# keycloak-realm-setup below.
KEYCLOAK_REALM=shortas-dev
# Must match .env.app's DASHBOARD_HOSTNAME — keycloak-realm-setup points
# the shortas-dashboard client's redirectUris/webOrigins at it (they
# default to localhost:3000 in realm-export.json, which would otherwise
# make login fail with "Invalid parameter: redirect_uri").
DASHBOARD_HOSTNAME=dashboard.yourdomain.com

# Real SMTP/SES credentials — same provider as .env.app's EMAIL_*/SMTP_*,
# reused here so Keycloak-sent emails (password reset, email verification)
# come from the same sender. keycloak-realm-setup configures the realm's
# outgoing email with these (it ships with none configured at all, so
# "forgot password" emails were otherwise silently never sent).
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USERNAME=changeme
SMTP_PASSWORD=changeme
EMAIL_FROM_ADDRESS=no-reply@yourdomain.com

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme-grafana-admin
GRAFANA_HOSTNAME=grafana.yourdomain.com

# Hetzner Object Storage credentials, only needed if Loki is configured to
# use it (see loki/config.yml) rather than local disk.
HETZNER_S3_ENDPOINT=https://nbg1.your-objectstorage.com
HETZNER_S3_LOKI_BUCKET=shortas-loki
HETZNER_S3_ACCESS_KEY=changeme
HETZNER_S3_SECRET_KEY=changeme
