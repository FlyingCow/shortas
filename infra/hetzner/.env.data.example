# Data node — copy to .env next to docker-compose.data.yml and fill in.
#
# These credentials are also referenced (same values!) from .env.app and
# .env.platform on the other nodes, since those services authenticate
# against the databases running here. Generate strong random values, e.g.
# `openssl rand -hex 24`, and keep this file out of git.

# Needed only for the sc-setup/topic-setup fluvio-cli image — see
# .env.app.example, same values.
IMAGE_REGISTRY=ghcr.io/flyingcow/shortas
IMAGE_TAG=latest

MONGO_ROOT_USER=shortas
MONGO_ROOT_PASSWORD=changeme-mongo

KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=changeme-keycloak-db

API_DB_NAME=shortas_db
API_DB_USER=shortas_user
API_DB_PASSWORD=changeme-api-db

CLICKHOUSE_PASSWORD=changeme-clickhouse

# Hetzner Object Storage — must match .env.app's S3_* values. ClickHouse's
# migrations (001-004) all create tables/views with
# SETTINGS storage_policy = 's3_main', which clickhouse-setup renders into
# storage.xml from these at boot; without it every one of those statements
# fails (silently, pre-fix — see apply_migrations.sh) with "Unknown
# storage policy". Reuses the same bucket as route-images, under its own
# prefix, rather than needing a second bucket.
S3_ENDPOINT=https://nbg1.your-objectstorage.com
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme
S3_ROUTE_IMAGES_BUCKET=shortas-route-images

REDIS_PASSWORD=changeme-redis

RABBITMQ_USER=shortas
RABBITMQ_PASSWORD=changeme-rabbitmq

# Google Safe Browsing API key for the gglsbl-rest service used by
# route-verifier. Get one at https://console.cloud.google.com (Safe Browsing
# API). NOTE: redirect/route-verifier/.env in this repo currently has a key
# committed in plaintext — rotate it before going to production and do not
# reuse it here.
GSB_API_KEY=changeme-gsb-api-key
