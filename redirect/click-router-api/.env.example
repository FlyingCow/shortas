# Application Configuration
APP_RUN_MODE=development
APP_CONFIG_PATH=./config

# AWS Configuration
AWS_ACCESS_KEY_ID=foobar
AWS_SECRET_ACCESS_KEY=foobar
AWS_DEFAULT_REGION=us-east-1

# Backtrace (useful for debugging panics)
RUST_BACKTRACE=1

# Logging Configuration
# Control logging verbosity with RUST_LOG environment variable
#
# Available log levels (from least to most verbose):
#   - error: Only show errors
#   - warn:  Show warnings and errors
#   - info:  Show informational messages (default)
#   - debug: Show debug information
#   - trace: Show very detailed trace information
#
# Examples:
#   RUST_LOG=error                       - Only errors
#   RUST_LOG=info                        - Info level (default)
#   RUST_LOG=debug                       - Debug level for all modules
#   RUST_LOG=click_router_api=debug      - Debug only for this application
#   RUST_LOG=info,click_router_api=debug - Info for all, debug for this app
#   RUST_LOG=info,salvo=warn             - Info for all, warn for salvo framework
#
# For development, use debug level:
RUST_LOG=debug

# For production, use info level:
# RUST_LOG=info
