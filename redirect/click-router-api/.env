APP_RUN_MODE=development
APP_CONFIG_PATH=./config
AWS_ACCESS_KEY_ID=foobar
AWS_SECRET_ACCESS_KEY=foobar
AWS_DEFAULT_REGION=us-east-1
RUST_BACKTRACE=1

# Logging configuration
# Levels: error, warn, info, debug, trace
# Examples:
#   RUST_LOG=debug                       - Enable debug for all modules
#   RUST_LOG=click_router_api=debug      - Enable debug only for this application
#   RUST_LOG=info,click_router_api=debug - Info for all, debug for this app
RUST_LOG=debug