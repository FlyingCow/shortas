    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug executable 'click-router'",
            "cargo": {
                "args": [
                    "build",
                    "--bin=click-router",
                    "--package=click-router"
                ],
                "filter": {
                    "name": "click-router",
                    "kind": "bin"
                }
            },
            "env": {
                "APP_RUN_MODE": "development"
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug unit tests in executable 'click-router'",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--bin=click-router",
                    "--package=click-router"
                ],
                "filter": {
                    "name": "click-router",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
    ]
}