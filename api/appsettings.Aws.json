{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "ApiSettings": {
    "ClickRouterApi": {
      "BaseUrl": "${CLICK_ROUTER_API_URL}",
      "Timeout": 30
    },
    "ClickAggregatorApi": {
      "BaseUrl": "${CLICK_AGGREGATOR_API_URL}",
      "Timeout": 30
    }
  },
  "Authentication": {
    "Provider": "Cognito",
    "Cognito": {
      "Region": "${AWS_REGION}",
      "UserPoolId": "${COGNITO_USER_POOL_ID}",
      "AppClientId": "${COGNITO_APP_CLIENT_ID}",
      "Authority": "${COGNITO_ISSUER_URL}",
      "ValidIssuer": "${COGNITO_ISSUER_URL}",
      "JwksUrl": "${COGNITO_JWKS_URL}",
      "Audience": "${COGNITO_APP_CLIENT_ID}",
      "RequireHttpsMetadata": true
    }
  },
  "Security": {
    "AllowedOrigins": "${ALLOWED_ORIGINS}",
    "RequireHttps": true
  },
  "RabbitMQ": {
    "Uri": "${APP_RABBITMQ_URI}",
    "DomainStateExchange": "domain.state.changed",
    "DomainStateQueue": "management-api.domain-state"
  },
  "DomainVerification": {
    "TxtRecordName": "_shortas-domain-challenge",
    "AllowedIpv4": "${ALLOWED_IPV4}",
    "AllowedIpv6": "${ALLOWED_IPV6}"
  },
  "ConnectionStrings": {
    "DefaultConnection": "${DATABASE_CONNECTION_STRING}"
  }
}
