{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/shortas-api-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "ApiSettings": {
    "ClickRouterApi": {
      "BaseUrl": "http://click-router-api:5810",
      "Timeout": 30
    },
    "ClickAggregatorApi": {
      "BaseUrl": "http://click-aggregator-api:5820",
      "Timeout": 30
    },
    "DomainVerifier": {
      "BaseUrl": "http://domain-verifier:5830",
      "Timeout": 30
    },
    "RouteVerifier": {
      "BaseUrl": "http://route-verifier:5831",
      "Timeout": 30
    }
  },
  "Keycloak": {
    "Authority": "http://keycloak:8080/realms/shortas-dev",
    "Audience": "shortas-api",
    "ClientId": "shortas-api",
    "ClientSecret": "shortas-api-secret",
    "RequireHttpsMetadata": false
  },
  "RateLimiting": {
    "RequestsPerMinute": 100,
    "BurstLimit": 20
  },
  "Security": {
    "AllowedOrigins": ["http://localhost:3000", "https://localhost:3000"],
    "RequireHttps": false
  },
  "Elasticsearch": {
    "Url": "http://shortas-api-elasticsearch:9200",
    "IndexName": "routes"
  },
  "RabbitMQ": {
    "Uri": "amqp://guest:guest@shortas-rabbitmq:5672/%2f",
    "DomainStateExchange": "domain.state.changed",
    "DomainStateQueue": "management-api.domain-state",
    "RouteStatusExchange": "route.status.changed",
    "RouteStatusQueue": "management-api.route-status"
  },
  "DomainVerification": {
    "TxtRecordName": "_shortas-domain-challenge",
    "AllowedIpv4": ["203.0.113.10"],
    "AllowedIpv6": []
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=shortas-api-postgres;Database=shortas_dev_db;Username=shortas_user;Password=shortas_password;Port=5432"
  },
  "S3": {
    "Endpoint": "http://shortas-minio:9000",
    "PublicEndpoint": "http://localhost:9003",
    "BucketName": "route-images",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "UsePathStyle": true
  }
}
